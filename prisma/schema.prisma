generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Level {
  Member
  Admin
}

model User {
  id           Int      @id @default(autoincrement())
  uuid         String   @unique @default(uuid())
  username     String   @unique
  email        String   @unique
  name         String?
  password     String
  balance      Decimal  @default(0) @db.Decimal(15, 2)
  level        Level    @default(Member)
  api_key      String?  @unique
  callback_url       String?
  server_area        String    @default("SG")
  mobile_session_version Int   @default(0)
  reset_token        String?
  reset_token_expiry DateTime?
  create_at          DateTime  @default(now())
  update_at          DateTime  @updatedAt

  articles           BlogArticle[]

  merchantWallet             MerchantWallet?
  merchantAccounts           MerchantAccount[]
  merchantWithdrawals        MerchantWithdrawal[]
  merchantWithdrawalSetting  MerchantWithdrawalSetting?

  @@map("user")
}

model ApiProvider {
  id        Int       @id @default(autoincrement())
  uuid      String    @unique @default(uuid())
  name      String
  slug      String    @unique
  url       String
  api_key   String
  balance   Decimal   @default(0) @db.Decimal(15, 2)
  create_at DateTime  @default(now())
  update_at DateTime  @updatedAt

  services  Service[]

  @@map("api_provider")
}

model Platform {
  id         Int        @id @default(autoincrement())
  uuid       String     @unique @default(uuid())
  name       String
  slug       String     @unique
  icon       String?
  create_at  DateTime   @default(now())
  update_at  DateTime   @updatedAt

  categories Category[]

  @@map("platform")
}

model Category {
  id          Int       @id @default(autoincrement())
  uuid        String    @unique @default(uuid())
  id_platform Int
  name        String
  slug        String    @unique
  description String?   @db.Text
  icon        String?
  create_at   DateTime  @default(now())
  update_at   DateTime  @updatedAt

  platform     Platform     @relation(fields: [id_platform], references: [id], onDelete: Cascade)
  services     Service[]
  data_details DataDetail[]

  @@map("category")
}

model DataDetail {
  id          Int      @id @default(autoincrement())
  id_category Int
  conteks     String   @db.Text
  create_at   DateTime @default(now())
  update_at   DateTime @updatedAt

  category    Category @relation(fields: [id_category], references: [id], onDelete: Cascade)

  @@map("data_detail")
}

model Service {
  id              Int          @id @default(autoincrement())
  uuid            String       @unique @default(uuid())
  id_category     Int
  id_api_provider Int?
  service_name    String
  slug            String       @unique
  service_id      String
  min             Int          @default(0)
  max             Int          @default(0)
  desc            String?      @db.Text
  rate_api        Decimal      @default(0) @db.Decimal(15, 4)
  rate_sale       Decimal      @default(0) @db.Decimal(15, 4) @map("rate_sale")
  create_at       DateTime     @default(now())
  update_at       DateTime     @updatedAt

  category        Category     @relation(fields: [id_category], references: [id], onDelete: Cascade)
  api_provider    ApiProvider? @relation(fields: [id_api_provider], references: [id], onDelete: SetNull)

  @@map("services")
}

model Setting {
  id              Int      @id @default(autoincrement())
  site_name       String
  favicon         String?
  logo            String?
  api_app         String?
  email           String?
  whatsapp        String?
  instagram       String?
  facebook        String?
  tiktok          String?
  telegram        String?
  url_image_kit   String?
  imagekit_api    String?
  imagekit_secret String?
  gemini_api      String?
  create_at       DateTime @default(now())
  update_at       DateTime @updatedAt

  @@map("setting")
}

model CryptomusSetting {
  id           Int      @id @default(autoincrement())
  uuid         String   @unique @default(uuid())
  merchant_id  String?
  payment_key  String?
  payout_key   String?
  webhook_url  String?
  return_url   String?
  currency     String   @default("USD")
  rate_usd     Decimal  @default(1) @db.Decimal(15, 4)
  min_deposit  Decimal  @default(1) @db.Decimal(15, 2)
  max_deposit  Decimal  @default(10000) @db.Decimal(15, 2)
  fee_percent  Decimal  @default(0) @db.Decimal(5, 2)
  is_active    Boolean  @default(false)
  is_test_mode Boolean  @default(false)
  create_at    DateTime @default(now())
  update_at    DateTime @updatedAt

  @@map("cryptomus_setting")
}

model CryptomusTransaction {
  id              Int      @id @default(autoincrement())
  uuid            String   @unique @default(uuid())
  order_id        String   @unique
  user_id         Int?
  merchant_id     String?
  amount          Decimal  @db.Decimal(15, 4)
  currency        String   @default("USD")
  crypto_amount   Decimal? @db.Decimal(24, 8)
  crypto_currency String?
  payment_status  String   @default("pending")
  invoice_url     String?
  txid            String?
  raw_response    String?  @db.Text
  create_at       DateTime @default(now())
  update_at       DateTime @updatedAt

  @@map("cryptomus_transaction")
}

model BlogCategory {
  id          Int           @id @default(autoincrement())
  uuid        String        @unique @default(uuid())
  name        String
  slug        String        @unique
  description String?       @db.Text
  color       String?       @default("emerald")
  create_at   DateTime      @default(now())
  update_at   DateTime      @updatedAt

  articles    BlogArticle[]

  @@map("blog_category")
}

model BlogArticle {
  id               Int           @id @default(autoincrement())
  uuid             String        @unique @default(uuid())
  title            String
  slug             String        @unique
  excerpt          String?       @db.Text
  content          String        @db.Text
  cover_image      String?
  category_id      Int?
  author_id        Int?
  author_name      String?       @default("Sociolizy Team")
  status           String        @default("PUBLISHED") // "DRAFT", "PUBLISHED", "ARCHIVED"
  views            Int           @default(0)
  reading_time     Int           @default(3)
  meta_title       String?
  meta_description String?       @db.Text
  tags             String?
  is_featured      Boolean       @default(false)
  published_at     DateTime?     @default(now())
  create_at        DateTime      @default(now())
  update_at        DateTime      @updatedAt

  category         BlogCategory? @relation(fields: [category_id], references: [id], onDelete: SetNull)
  author           User?         @relation(fields: [author_id], references: [id], onDelete: SetNull)

  @@index([status, published_at])
  @@index([category_id])
  @@map("blog_article")
}

model CustomPage {
  id               Int      @id @default(autoincrement())
  uuid             String   @unique @default(uuid())
  title            String
  slug             String   @unique
  description      String?  @db.Text
  blocks           Json     @default("[]")
  styles           Json?
  status           String   @default("PUBLISHED") // "DRAFT", "PUBLISHED"
  meta_title       String?
  meta_description String?  @db.Text
  views            Int      @default(0)
  create_at        DateTime @default(now())
  update_at        DateTime @updatedAt

  @@index([slug])
  @@index([status])
  @@map("custom_page")
}

// ==========================================
// MERCHANT PAYMENT GATEWAY MODELS
// ==========================================

model MerchantWallet {
  id              Int      @id @default(autoincrement())
  uuid            String   @unique @default(uuid())
  userId          Int      @unique
  balance         Decimal  @default(0) @db.Decimal(15, 4)
  lockedBalance   Decimal  @default(0) @db.Decimal(15, 4)
  totalEarned     Decimal  @default(0) @db.Decimal(15, 4)
  totalWithdrawn  Decimal  @default(0) @db.Decimal(15, 4)
  currency        String   @default("USD")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("merchant_wallet")
}

model MerchantWithdrawalSetting {
  id              Int      @id @default(autoincrement())
  uuid            String   @unique @default(uuid())
  userId          Int      @unique
  coin            String   @default("USDT")
  network         String   @default("tron")
  address         String
  autoWithdraw    Boolean  @default(false)
  threshold       Decimal  @default(50.00) @db.Decimal(15, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("merchant_withdrawal_setting")
}

model MerchantAccount {
  id           Int                  @id @default(autoincrement())
  uuid         String               @unique @default(uuid())
  userId       Int
  name         String
  slug         String               @unique
  description  String?              @db.Text
  status       String               @default("ACTIVE") // ACTIVE, SUSPENDED
  allowedCoins Json?                @default("[\"USDT_TRC20\",\"USDT_BSC\",\"BTC\",\"ETH\",\"TON\",\"SOL\",\"LTC\",\"TRX\"]")
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  websites     MerchantWebsite[]
  transactions MerchantTransaction[]
  withdrawals  MerchantWithdrawal[]

  @@index([userId])
  @@map("merchant_account")
}

model MerchantWebsite {
  id          Int                   @id @default(autoincrement())
  uuid        String                @unique @default(uuid())
  merchantId  Int
  name        String
  domain      String
  apiKey      String                @unique
  secretKey   String
  webhookUrl  String?
  returnUrl   String?
  status      String                @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  merchant    MerchantAccount       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  transactions MerchantTransaction[]

  @@index([merchantId])
  @@map("merchant_website")
}

model MerchantTransaction {
  id                      Int              @id @default(autoincrement())
  uuid                    String           @unique @default(uuid())
  orderId                 String           // Merchant's external order ID
  merchantId              Int
  websiteId               Int?
  amountUsd               Decimal          @db.Decimal(15, 4)
  adminFee                Decimal          @default(0) @db.Decimal(15, 4)
  netAmountUsd            Decimal          @db.Decimal(15, 4)
  cryptoCurrency          String?          // e.g. USDT
  cryptoNetwork           String?          // e.g. tron
  cryptoAmount            Decimal?         @db.Decimal(24, 8)
  payAddress              String?
  paymentStatus           String           @default("PENDING") // PENDING, PAID, EXPIRED, FAILED, CANCELLED
  txid                    String?
  cryptomusOrderId        String?          @unique
  merchantWebhookStatus   String?          @default("PENDING") // PENDING, SENT, FAILED
  merchantWebhookAttempts Int              @default(0)
  merchantWebhookResponse String?          @db.Text
  description             String?
  customerEmail           String?
  returnUrl               String?
  callbackUrl             String?
  expiresAt               DateTime?
  paidAt                  DateTime?
  rawPayload              String?          @db.Text
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  merchant                MerchantAccount  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  website                 MerchantWebsite? @relation(fields: [websiteId], references: [id], onDelete: SetNull)

  @@index([merchantId])
  @@index([websiteId])
  @@index([paymentStatus])
  @@index([createdAt])
  @@map("merchant_transaction")
}

model MerchantWithdrawal {
  id                Int              @id @default(autoincrement())
  uuid              String           @unique @default(uuid())
  userId            Int
  merchantId        Int?
  amountUsd         Decimal          @db.Decimal(15, 4)
  feeAdmin          Decimal          @default(0) @db.Decimal(15, 4)
  netAmountUsd      Decimal          @db.Decimal(15, 4)
  coin              String           // e.g. USDT
  network           String           // e.g. tron
  address           String
  status            String           @default("PENDING") // PENDING, PROCESSING, COMPLETED, REJECTED, FAILED
  isAuto            Boolean          @default(false)
  txid              String?
  cryptomusPayoutId String?
  errorMessage      String?          @db.Text
  processedAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant          MerchantAccount? @relation(fields: [merchantId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("merchant_withdrawal")
}

model MerchantGatewaySetting {
  id                    Int      @id @default(autoincrement())
  adminFeePercent       Decimal  @default(1.0) @db.Decimal(5, 2)
  adminFeeFixed         Decimal  @default(0.10) @db.Decimal(15, 4)
  minWithdrawal         Decimal  @default(10.00) @db.Decimal(15, 2)
  maxWithdrawal         Decimal  @default(50000.00) @db.Decimal(15, 2)
  autoWithdrawalEnabled Boolean  @default(true)
  allowedCoins          Json?    @default("[\"USDT\",\"BTC\",\"ETH\",\"TON\",\"SOL\",\"LTC\",\"TRX\"]")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("merchant_gateway_setting")
}


