generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Level {
  Member
  Admin
}

model User {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(uuid())
  username  String   @unique
  email     String   @unique
  password  String
  balance   Decimal  @default(0) @db.Decimal(15, 2)
  level       Level    @default(Member)
  api_key     String?  @unique
  server_area String   @default("SG")
  create_at   DateTime @default(now())
  update_at   DateTime @updatedAt

  @@map("user")
}

model ApiProvider {
  id        Int       @id @default(autoincrement())
  uuid      String    @unique @default(uuid())
  name      String
  slug      String    @unique
  url       String
  api_key   String
  balance   Decimal   @default(0) @db.Decimal(15, 2)
  create_at DateTime  @default(now())
  update_at DateTime  @updatedAt

  services  Service[]

  @@map("api_provider")
}

model Platform {
  id         Int        @id @default(autoincrement())
  uuid       String     @unique @default(uuid())
  name       String
  slug       String     @unique
  icon       String?
  create_at  DateTime   @default(now())
  update_at  DateTime   @updatedAt

  categories Category[]

  @@map("platform")
}

model Category {
  id          Int       @id @default(autoincrement())
  uuid        String    @unique @default(uuid())
  id_platform Int
  name        String
  slug        String    @unique
  description String?   @db.Text
  icon        String?
  create_at   DateTime  @default(now())
  update_at   DateTime  @updatedAt

  platform    Platform  @relation(fields: [id_platform], references: [id], onDelete: Cascade)
  services    Service[]

  @@map("category")
}

model Service {
  id              Int          @id @default(autoincrement())
  uuid            String       @unique @default(uuid())
  id_category     Int
  id_api_provider Int?
  service_name    String
  slug            String       @unique
  service_id      String
  min             Int          @default(0)
  max             Int          @default(0)
  desc            String?      @db.Text
  rate_api        Decimal      @default(0) @db.Decimal(15, 4)
  rate_sale       Decimal      @default(0) @db.Decimal(15, 4) @map("rate_sale")
  create_at       DateTime     @default(now())
  update_at       DateTime     @updatedAt

  category        Category     @relation(fields: [id_category], references: [id], onDelete: Cascade)
  api_provider    ApiProvider? @relation(fields: [id_api_provider], references: [id], onDelete: SetNull)

  @@map("services")
}

model Setting {
  id              Int      @id @default(autoincrement())
  site_name       String
  favicon         String?
  logo            String?
  api_app         String?
  email           String?
  whatsapp        String?
  instagram       String?
  facebook        String?
  tiktok          String?
  telegram        String?
  url_image_kit   String?
  imagekit_api    String?
  imagekit_secret String?
  create_at       DateTime @default(now())
  update_at       DateTime @updatedAt

  @@map("setting")
}

model CryptomusSetting {
  id           Int      @id @default(autoincrement())
  uuid         String   @unique @default(uuid())
  merchant_id  String?
  payment_key  String?
  payout_key   String?
  webhook_url  String?
  return_url   String?
  currency     String   @default("USD")
  rate_usd     Decimal  @default(1) @db.Decimal(15, 4)
  min_deposit  Decimal  @default(1) @db.Decimal(15, 2)
  max_deposit  Decimal  @default(10000) @db.Decimal(15, 2)
  fee_percent  Decimal  @default(0) @db.Decimal(5, 2)
  is_active    Boolean  @default(false)
  is_test_mode Boolean  @default(false)
  create_at    DateTime @default(now())
  update_at    DateTime @updatedAt

  @@map("cryptomus_setting")
}

model CryptomusTransaction {
  id              Int      @id @default(autoincrement())
  uuid            String   @unique @default(uuid())
  order_id        String   @unique
  user_id         Int?
  merchant_id     String?
  amount          Decimal  @db.Decimal(15, 4)
  currency        String   @default("USD")
  crypto_amount   Decimal? @db.Decimal(24, 8)
  crypto_currency String?
  payment_status  String   @default("pending")
  invoice_url     String?
  txid            String?
  raw_response    String?  @db.Text
  create_at       DateTime @default(now())
  update_at       DateTime @updatedAt

  @@map("cryptomus_transaction")
}
