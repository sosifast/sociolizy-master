generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Level {
  Member
  Admin
}

model User {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(uuid())
  username  String   @unique
  email     String   @unique
  password  String
  balance   Decimal  @default(0) @db.Decimal(15, 2)
  level       Level    @default(Member)
  api_key     String?  @unique
  server_area String   @default("SG")
  create_at   DateTime @default(now())
  update_at   DateTime @updatedAt

  @@map("user")
}

model ApiProvider {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  url       String
  api_key   String
  balance   Decimal  @default(0) @db.Decimal(15, 2)
  create_at DateTime @default(now())
  update_at DateTime @updatedAt

  @@map("api_provider")
}

model Platform {
  id         Int        @id @default(autoincrement())
  uuid       String     @unique @default(uuid())
  name       String
  slug       String     @unique
  icon       String?
  create_at  DateTime   @default(now())
  update_at  DateTime   @updatedAt

  categories Category[]

  @@map("platform")
}

model Category {
  id          Int       @id @default(autoincrement())
  uuid        String    @unique @default(uuid())
  id_platform Int
  name        String
  slug        String    @unique
  description String?   @db.Text
  icon        String?
  create_at   DateTime  @default(now())
  update_at   DateTime  @updatedAt

  platform    Platform  @relation(fields: [id_platform], references: [id], onDelete: Cascade)
  services    Service[]

  @@map("category")
}

model Service {
  id           Int      @id @default(autoincrement())
  uuid         String   @unique @default(uuid())
  id_category  Int
  service_name String
  slug         String   @unique
  service_id   String
  min          Int      @default(0)
  max          Int      @default(0)
  desc         String?  @db.Text
  rate_api     Decimal  @default(0) @db.Decimal(15, 4)
  rate_sale    Decimal  @default(0) @db.Decimal(15, 4) @map("rate_sale")
  create_at    DateTime @default(now())
  update_at    DateTime @updatedAt

  category     Category @relation(fields: [id_category], references: [id], onDelete: Cascade)

  @@map("services")
}

model Setting {
  id        Int      @id @default(autoincrement())
  site_name String
  favicon   String?
  logo      String?
  api_app   String?
  create_at DateTime @default(now())
  update_at DateTime @updatedAt

  @@map("setting")
}
